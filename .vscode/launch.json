{
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Converter Tests",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest",
            "args": [
                "--runInBand",
                "--testMatch",
                "**/Converter.test.ts"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}
