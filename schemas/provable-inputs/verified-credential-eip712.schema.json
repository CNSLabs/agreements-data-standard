{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/verified-credential-eip712.schema.json",
  "title": "Verifiable Credential with EIP-712 Signature",
  "description": "Schema for W3C Verifiable Credentials signed with EIP-712 signatures",
  "type": "object",
  "required": ["@context", "type", "issuer", "issuanceDate", "credentialSubject", "proof"],
  "properties": {
    "@context": {
      "type": ["string", "array"],
      "description": "The JSON-LD context of the credential",
      "default": ["https://www.w3.org/2018/credentials/v1", "https://identity.foundation/EcdsaSecp256k1RecoverySignature2020/lds-ecdsa-secp256k1-recovery2020-0.0.jsonld"]
    },
    "id": {
      "type": "string",
      "format": "uri",
      "description": "The unique identifier for the credential"
    },
    "type": {
      "type": ["string", "array"],
      "description": "The types of the credential",
      "items": {
        "type": "string"
      },
      "default": ["VerifiableCredential"]
    },
    "issuer": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri",
          "description": "The URI of the issuer"
        },
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uri",
              "description": "The DID of the issuer"
            },
            "name": {
              "type": "string",
              "description": "The name of the issuer"
            }
          }
        }
      ],
      "description": "The entity that issued the credential"
    },
    "issuanceDate": {
      "type": "string",
      "format": "date-time",
      "description": "The date and time when the credential was issued"
    },
    "expirationDate": {
      "type": "string",
      "format": "date-time",
      "description": "The date and time when the credential expires"
    },
    "credentialSubject": {
      "type": "object",
      "description": "Claims about the subject of the credential",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "description": "The URI of the subject"
        }
      },
      "additionalProperties": true
    },
    "proof": {
      "type": "object",
      "required": ["type", "created", "proofPurpose", "verificationMethod", "eip712", "proofValue"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["EthereumEip712Signature2021"],
          "description": "The type of proof"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time when the proof was created"
        },
        "proofPurpose": {
          "type": "string",
          "enum": ["assertionMethod", "authentication", "keyAgreement", "contractAgreement", "capabilityInvocation", "capabilityDelegation"],
          "description": "The purpose of the proof"
        },
        "verificationMethod": {
          "type": "string",
          "format": "uri",
          "description": "The URI of the verification method used to verify the proof"
        },
        "eip712": {
          "type": "object",
          "required": ["domain", "types", "primaryType"],
          "properties": {
            "domain": {
              "type": "object",
              "required": ["name", "version", "chainId", "verifyingContract"],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the signing domain"
                },
                "version": {
                  "type": "string",
                  "description": "The version of the signing domain"
                },
                "chainId": {
                  "type": "integer",
                  "description": "The chain ID of the blockchain network"
                },
                "verifyingContract": {
                  "type": "string",
                  "pattern": "^0x[a-fA-F0-9]{40}$",
                  "description": "The address of the contract that will verify the signature"
                }
              }
            },
            "types": {
              "type": "object",
              "description": "The type definitions used for EIP-712 structured data",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "The name of the field"
                    },
                    "type": {
                      "type": "string",
                      "description": "The type of the field"
                    }
                  }
                }
              }
            },
            "primaryType": {
              "type": "string",
              "description": "The primary type being signed"
            }
          }
        },
        "proofValue": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]+$",
          "description": "The EIP-712 signature value"
        }
      }
    }
  }
} 