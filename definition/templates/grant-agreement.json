                                "stateMutability": "nonpayable",
                                "type": "function"
                            }
                        ]
                    }
                ],
                "transactions": [
                    {
                        "id": "transferGrant",
                        "contractId": "grantContract",
                        "method": "transfer",
                        "params": {
                            "to": "${grantRecipient.blockchainAddress}",
                            "amount": "${grantAmount}"
                        },
                        "description": "Transfer grant tokens to recipient"
                    }
                ]
            }
        ]
    },
    "executionFlow": {
        "states": [
            "DRAFT",
            "AWAITING_SIGNATURES",
            "ACTIVE",
            "MONTHLY_REVIEW",
            "APPROVED",
            "FULFILLED",
            "REJECTED",
            "FAILED_CONTRACT_CONDITION"
        ],
        "transitions": [
            {
                "from": "DRAFT",
                "to": "AWAITING_SIGNATURES",
                "conditions": [
                    {
                        "type": "variablesSet",
                        "variables": [
                            "effectiveDate",
                            "grantAmount",
                            "numberOfMonths"
                        ]
                    }
                ]
            },
            {
                "from": "AWAITING_SIGNATURES",
                "to": "ACTIVE",
                "conditions": [
                    {
                        "type": "and",
                        "conditions": [
                            {
                                "type": "signatureValid",
                                "signature": "grantRecipientSignature"
                            },
                            {
                                "type": "signatureValid",
                                "signature": "allocatorSignature"
                            }
                        ]
                    }
                ]
            },
            {
                "from": "ACTIVE",
                "to": "MONTHLY_REVIEW",
                "conditions": [
                    {
                        "type": "signatureValid",
                        "signature": "completionSignature"
                    }
                ],
                "actions": [
                    {
                        "type": "setVariable",
                        "variable": "lastUpdated",
                        "value": "${currentTimestamp}"
                    }
                ]
            },
            {
                "from": "MONTHLY_REVIEW",
                "to": "MONTHLY_REVIEW",
                "conditions": [
                    {
                        "type": "and",
                        "conditions": [
                            {
                                "type": "signatureValid",
                                "signature": "monthlyCheckinApprovalSignature"
                            },
                            {
                                "type": "comparison",
                                "operator": "lessThan",
                                "left": "${monthlyReviewCount}",
                                "right": "${numberOfMonths}"
                            }
                        ]
                    }
                ],
                "actions": [
                    {
                        "type": "incrementVariable",
                        "variable": "monthlyReviewCount"
                    },
                    {
                        "type": "setVariable",
                        "variable": "lastUpdated",
                        "value": "${currentTimestamp}"
                    }
                ]
            },
            {
                "from": "MONTHLY_REVIEW",
                "to": "FAILED_CONTRACT_CONDITION",
                "conditions": [
                    {
                        "type": "comparison",
                        "operator": "greaterThan",
                        "left": "${currentTimestamp}",
                        "right": "${lastUpdated + 30 days}"
                    }
                ]
            },
            {
                "from": "MONTHLY_REVIEW",
                "to": "APPROVED",
                "conditions": [
                    {
                        "type": "comparison",
                        "operator": "equals",
                        "left": "${monthlyReviewCount}",
                        "right": "${numberOfMonths}"
                    }
                ]
            },
            {
                "from": "APPROVED",
                "to": "FULFILLED",
                "conditions": [
                    {
                        "type": "transactionExecuted",
                        "transactionId": "transferGrant"
                    }
                ]
            },
            {
                "from": "ACTIVE",
                "to": "REJECTED",
                "conditions": [
                    {
                        "type": "signatureValid",
                        "signature": "rejectionSignature"
                    }
                ]
            }
        ]
    }
}