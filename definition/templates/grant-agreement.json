{
    "metadata": {
        "id": "did:example:123456789abcdefghi",
        "templateId": "did:template:grant-agreement-v1",
        "version": "1.0.0",
        "jurisdiction": "CAYMAN_ISLANDS",
        "createdAt": "2024-03-20T12:00:00Z",
        "status": "DRAFT"
    },
    "inputTemplateVariables": {
        "effectiveDate": {
            "type": "date",
            "displayName": "Effective Date",
            "description": "The date when this agreement becomes effective",
            "category": "agreementVariable",
            "props": {
                "value": null,
                "mutable": true,
                "required": true
            }
        },
        "termEndDate": {
            "type": "date",
            "displayName": "Term End Date",
            "description": "The date when this agreement concludes",
            "category": "agreementVariable",
            "props": {
                "value": "10/20/2025",
                "mutable": true,
                "required": true
            }
        },
        "foundation": {
            "id": "did:example:foundation",
            "type": "identity",
            "props": {
                "type": "organization",
                "name": "Ecosystem Name Foundation",
                "jurisdiction": "CAYMAN_ISLANDS",
                "blockchainAddress": "${foundationAddress}",
                "role": "GRANTOR"
            }
        },
        "grantRecipient": {
            "id": "did:example:grantRecipient",
            "type": "identity",
            "displayName": "Grant Recipient",
            "description": "The recipient of the grant",
            "props": {
                "type": "individual",
                "name": "${recipientName}",
                "blockchainAddress": "${recipientAddress}",
                "role": "GRANTEE"
            }
        },
        "tokenAllocator": {
            "id": "did:example:tokenAllocator",
            "type": "identity",
            "displayName": "Token Allocator",
            "description": "The allocator of the tokens",
            "props": {
                "type": "individual",
                "name": "${allocatorName}",
                "blockchainAddress": "${allocatorAddress}",
                "role": "GRANTEE"
            }
        },
        "grantAmount": {
            "id": "grantAmount",
            "type": "uint256",
            "displayName": "Grant Amount",
            "description": "Amount of tokens to be granted",
            "props": {  
                "value": null,
                "mutable": true,
                "required": true,
                "category": "blockchain"
            }
        },
        "grantContract": {
            "id": "grantContract",
            "type": "evm",
            "props": {
                "address": "${grantContractAddress}",
                "chainId": "${grantContractChainId}",
                "abi": {
                    "inputs": [
                        {
                            "internalType": "address",
                            "name": "to",
                            "type": "address"
                        },
                        {
                            "internalType": "uint256",
                            "name": "amount",
                            "type": "uint256"
                        }
                    ],
                    "name": "transfer",
                    "outputs": [
                        {
                            "internalType": "bool",
                            "name": "",
                            "type": "bool"
                        }
                    ],
                    "stateMutability": "nonpayable",
                    "type": "function"
                }
            }
        }
    },
    "content": {
        "sections": [
            {
                "id": "heading",
                "type": "heading",
                "level": 1,
                "content": [
                    {
                        "type": "text",
                        "text": "Grant Agreement",
                        "styles": {
                            "bold": true
                        }
                    }
                ],
                "props": {
                    "textColor": "default",
                    "backgroundColor": "default",
                    "textAlignment": "left"
                }
            },
            {
                "id": "introduction",
                "type": "paragraph",
                "content": [
                    {
                        "type": "text",
                        "text": "This Grant Agreement (",
                        "styles": {}
                    },
                    {
                        "type": "text",
                        "text": "\"Agreement\"",
                        "styles": {
                            "bold": true
                        }
                    },
                    {
                        "type": "text",
                        "text": ") is entered into on ${effectiveDate}, (the ",
                        "styles": {}
                    },
                    {
                        "type": "text",
                        "text": "\"Effective Date\"",
                        "styles": {
                            "bold": true
                        }
                    },
                    {
                        "type": "text",
                        "text": "), between ${foundation.name}, a ${foundation.jurisdiction} foundation company (the ",
                        "styles": {}
                    },
                    {
                        "type": "text",
                        "text": "\"Foundation\"",
                        "styles": {
                            "bold": true
                        }
                    },
                    {
                        "type": "text",
                        "text": ") with D3 address ${foundation.blockchainAddress}, and ${grantRecipient.name}, an individual with address ${grantRecipient.blockchainAddress} (",
                        "styles": {}
                    },
                    {
                        "type": "text",
                        "text": "\"Grant Recipient\"",
                        "styles": {
                            "bold": true
                        }
                    },
                    {
                        "type": "text",
                        "text": ").",
                        "styles": {}
                    }
                ],
                "props": {
                    "textColor": "default",
                    "backgroundColor": "default",
                    "textAlignment": "left"
                }
            }
        ]
    },
    "executionFlow": {
        "states": [
            "DRAFT",
            "AWAITING_SIGNATURES",
            "ACTIVE_PENDING_REVIEW",
            "APPROVED",
            "REJECTED",
            "PAYMENT_PENDING",
            "COMPLETED"
        ],
        "inputs": {
            "grantRecipientSignature": {
                "id": "grantRecipientSignature",
                "type": "eip712Signature",
                "displayName": "Grant Recipient Signature",
                "description": "EIP712 signature from the grant recipient accepting the terms of the grant agreement",
                "value": null,
                "mutable": true,
                "required": true,
                "category": "blockchain",
                "signer": "${grantRecipient.props.blockchainAddress}"
            },
            "workApprovedSignature": {
                "id": "workApprovedSignature",
                "type": "eip712Signature",
                "displayName": "Work Approved Signature",
                "description": "EIP712 signature from the token allocator attesting that the grant work has been completed successfully",
                "value": null,
                "mutable": true,
                "required": true,
                "category": "blockchain",
                "signer": "${tokenAllocator.props.blockchainAddress}"
            },
            "workRejectedSignature": {
                "id": "workRejectedSignature",
                "type": "eip712Signature",
                "displayName": "Work Rejected Signature",
                "description": "EIP712 signature from the token allocator attesting that the grant work has been rejected",
                "value": null,
                "mutable": true,
                "required": false,
                "category": "blockchain",
                "signer": "${tokenAllocator.props.blockchainAddress}"
            },
            "grantTransactionProof": {
                "id": "grantTransactionProof",
                "type": "transactionProof",
                "displayName": "Grant Transaction Proof",
                "description": "Proof of successful token transfer to grant recipient",
                "category": "verifiableInput",
                "props": {
                    "chainId": "${chainId}",
                    "transactionType": "contractCall",
                    "contractCall": {
                        "method": "transfer",
                        "params": {
                            "to": "${grantRecipient.props.blockchainAddress}",
                            "amount": "${grantAmount}"
                        },
                        "contractReference": "${grantContract}"
                    }
                }
            }
        },
        "transitions": [
            {
                "from": "DRAFT",
                "to": "AWAITING_SIGNATURES",
                "conditions": [
                    {
                        "type": "variablesSet",
                        "inputs": [
                            "effectiveDate",
                            "grantAmount",
                            "termEndDate",
                            "grantContract"
                        ]
                    }
                ]
            },
            {
                "from": "AWAITING_SIGNATURES",
                "to": "ACTIVE_PENDING_REVIEW",
                "conditions": [
                    {
                        "type": "isValid",
                        "inputs": ["grantRecipientSignature"]
                    }
                ]
            },
            {
                "from": "ACTIVE_PENDING_REVIEW",
                "to": "PAYMENT_PENDING",
                "conditions": [
                    {
                        "type": "isValid",
                        "inputs": ["workApprovedSignature"]
                    }
                ]
            },
            {
                "from": "ACTIVE_PENDING_REVIEW",
                "to": "REJECTED",
                "conditions": [
                    {
                        "type": "isValid",
                        "inputs": ["workRejectedSignature"]
                    }
                ]
            },
            {
                "from": "PAYMENT_PENDING",
                "to": "COMPLETED",
                "conditions": [
                    {
                        "type": "isValid",
                        "inputs": ["grantTransactionProof"]
                    }
                ]
            }
        ]
    }
}